{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log)",
      "Bash(git log *)",
      "Bash(git show)",
      "Bash(git show *)",
      "Bash(pnpm check)",
      "Bash(pnpm lint)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm test)",
      "Bash(pnpm test *)",
      "Bash(pnpm exec vitest run *)",
      "Bash(pnpm e2e)",
      "Bash(pnpm e2e *)"
    ],
    "deny": [
      "Bash(git diff *--output*)",
      "Bash(git diff *--ext-diff*)",
      "Bash(git diff *--textconv*)",
      "Bash(git log *--output*)",
      "Bash(git log *--ext-diff*)",
      "Bash(git log *--textconv*)",
      "Bash(git show *--output*)",
      "Bash(git show *--ext-diff*)",
      "Bash(git show *--textconv*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-bash.mjs"
          }
        ]
      }
    ]
  }
}
